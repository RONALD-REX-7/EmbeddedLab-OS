# EmbeddedLab OS — Environment Variable Template
# Copy this file to .env.local to configure credentials.
# Running without credentials enables Local Offline Demo Mode automatically.

# ─── Supabase Configuration (Client-Safe / Public) ─────────────────────────
# Required for persistent authentication and cloud progress tracking.
# Found in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── Google Gemini AI (Server-Only Secret) ──────────────────────────────────
# Required for live contextual tutoring. If omitted, deterministic offline fallback is used.
# Found in: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
